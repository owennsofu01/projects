rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every piece of app data lives under users/{uid} — the user doc itself
    // (currencyCode, themeMode, profile fields) plus subcollections
    // (products, products/{id}/batches, sales, expenses). The recursive
    // wildcard below covers all of them, at any depth, in one rule instead
    // of listing each collection (and forgetting nested ones like batches).
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
